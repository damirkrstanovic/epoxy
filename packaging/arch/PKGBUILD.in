pkgname=epoxy-signing
pkgver=@VERSION@
pkgrel=1
pkgdesc='Smart-card signing helper for ePorezi with native PIN entry and tray controls'
arch=('x86_64')
url='https://github.com/damirkrstanovic/epoxy'
license=('@BUNDLED_LICENSES@')
depends=('gtk4' 'nss' 'nspr' 'libxml2' 'xmlsec' 'opensc' 'pcsclite' 'ccid')
makedepends=('rust' 'cargo' 'clang' 'pkgconf' 'desktop-file-utils')
optdepends=('systemd: optional user socket activation')
provides=('epoxy')
conflicts=('epoxy' 'epoxy-git')
source=("$pkgname-$pkgver.tar.xz")
sha256sums=('@SHA256@')
options=('!lto' '!debug')

build() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p epoxy
}

check() {
    cd "$pkgname-$pkgver"
    desktop-file-validate packaging/common/epoxy-signing.desktop
    cargo test --frozen --release -p epoxy --lib
}

package() {
    cd "$pkgname-$pkgver"
    packaging/install.sh "$pkgdir" target/release/epoxy
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
