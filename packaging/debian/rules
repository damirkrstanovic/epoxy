#!/usr/bin/make -f
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --frozen --release -p epoxy

override_dh_auto_test:
	desktop-file-validate packaging/common/epoxy-signing.desktop
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --frozen --release -p epoxy --lib
endif

override_dh_auto_install:
	packaging/install.sh debian/epoxy-signing target/release/epoxy

override_dh_auto_clean:
	rm -rf target

# User units are intentionally opt-in; never enable or restart user services.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable --no-start
